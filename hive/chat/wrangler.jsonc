{
  "$schema": "https://unpkg.com/wrangler@4.135.0/config-schema.json",
  "name": "cedwyn-hive-chat",
  "main": "worker.js",
  "compatibility_date": "2025-01-01",
  "workers_dev": false,
  "preview_urls": true,
  "durable_objects": {
    "bindings": [
      {
        "name": "CHAT",
        "class_name": "HiveChat"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["HiveChat"]
    }
  ],
  "routes": [
    {
      "pattern": "cedwyn-datro.bucklerfamily.estate/hive/chat*",
      "zone_name": "bucklerfamily.estate"
    },
    {
      "pattern": "cedwyn-datro.bucklerfamily.estate/hive/api/chat*",
      "zone_name": "bucklerfamily.estate"
    }
  ],
  "triggers": {
    "crons": ["7 * * * *"]
  },
  "previews": {
    "durable_objects": {
      "bindings": [
        {
          "name": "CHAT",
          "class_name": "HiveChat"
        }
      ]
    }
  }
}
